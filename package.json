{
  "name": "app-builder-agents",
  "version": "1.0.0",
  "description": "Multi-agent system for building full-stack applications using Claude",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest --testPathPattern=tests/ --forceExit",
    "test:watch": "jest --testPathPattern=tests/ --watch",
    "mocks:build-map": "node scripts/build-agent-map.js",
    "mocks:generate": "node scripts/generate-mocks.js",
    "mocks:sync": "node scripts/build-agent-map.js && node scripts/generate-mocks.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 120000
  }
}
